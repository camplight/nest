# Nest product + untouched OrgOps engine
# Product settings live separately from engine state.
# ORGOPS_URL=http://127.0.0.1:8788          # set only for an externally managed engine
# NEST_PRODUCT_DB_PATH=.nest-product/nest.sqlite
# NEST_ENGINE_DATA_DIR=.nest-data
# NEST_ENGINE_DB_FILE=nest.sqlite
# ORGOPS_PORT=8788
# ORGOPS_BIND_HOST=127.0.0.1

# --- API (apps/api) ---
PORT=8787
NEST_ADMIN_USER=admin
NEST_ADMIN_PASS=admin
NEST_RUNNER_TOKEN=dev-runner-token
NEST_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY= # 32-byte base64; required for secrets encryption
NEST_EVENT_MAX_FAILURES=25
NEST_COOKIE_SECURE=auto # auto|always|never
# Engine project root is managed by Nest under NEST_ENGINE_DATA_DIR/engine.
# NEST_EVENT_SHAPES_CACHE_TTL_MS=3000       # optional event-shapes cache ttl
# NEST_RUNNER_ONLINE_THRESHOLD_MS=15000     # optional runner online threshold

# --- OrgOps runner (vendor/orgops/apps/agent-runner) ---
NEST_API_URL=http://127.0.0.1:8787
# NEST_LLM_STUB=1                          # set to stub LLM calls (tests)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=
# NEST_LLM_CALL_TIMEOUT_MS=10800000
# NEST_HISTORY_MAX_EVENTS=250
# NEST_HISTORY_MAX_CHARS=120000
# NEST_CHANNEL_RECENT_MEMORY_INTERVAL_MS=10000
# NEST_CHANNEL_FULL_MEMORY_INTERVAL_MS=60000
# NEST_CROSS_RECENT_MEMORY_INTERVAL_MS=15000
# NEST_CROSS_FULL_MEMORY_INTERVAL_MS=120000
# NEST_AGENT_INTENT_TIMEOUT_MS=45000
# NEST_AGENT_INTENT_MAX_TIMEOUTS=3
# NEST_GIT_BASH_PATH=
# NEST_SHELL_PATH=
# NEST_SHELL_ARGS=
# NEST_SHELL_TIMEOUT_KILL_GRACE_MS=5000
# NEST_RLM_MAX_STEPS=24
# NEST_RLM_EVAL_TIMEOUT_MS=10000
# NEST_RLM_MAX_INPUT_CHARS=16000
# NEST_RLM_MAX_OUTPUT_CHARS=16000
# NEST_RLM_PROMPT_PREVIEW_MAX_CHARS=4000
# NEST_RLM_MAX_SUBAGENT_DEPTH=3
# NEST_RLM_MAX_SUBAGENTS_PER_EVENT=12

# --- Nest CLI (apps/cli) ---
# NEST_CLI_MODEL=openai:gpt-5.2
# NEST_CLI_MAX_STEPS=20
# NEST_CLI_COMMAND_TIMEOUT_MS=120000
# NEST_CLI_EVAL_TIMEOUT_MS=30000
# NEST_CLI_EVAL_CALLBACK_TIMEOUT_MS=8000
# NEST_CLI_MAX_CONTEXT_CHARS=100000
# NEST_CLI_MAX_SUMMARY_CHARS=14000
# NEST_CLI_SUMMARY_CHUNK_MESSAGES=8
# NEST_CLI_MIN_RECENT_MESSAGES=12
# NEST_CLI_MAX_SYSTEM_DOC_CHARS=40000
# NEST_CLI_DEBUG=0
# NEST_CLI_SPINNER=1
# NEST_CLI_PROGRESS=1
# NEST_CLI_LOG_PATH=.nest-output.log
# NEST_CLI_DOUBLE_SIGINT_MS=1200

# --- Admin UI (apps/admin-ui) ---
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=/ws

# --- User UI (apps/user-ui) ---
# VITE_API_BASE_URL=/api
# Optional override for the Nest CLI install/upgrade source repository.
# NEST_REPO_URL=https://github.com/camplight/nest.git

# --- Google Workspace sign-in (optional; enable in Admin > Sign-in) ---
# Keep the client secret in the private server environment, never in a VITE_* value.
# NEST_GOOGLE_CLIENT_ID=
# NEST_GOOGLE_CLIENT_SECRET=
# NEST_GOOGLE_REDIRECT_URI=https://nest.example.com/api/auth/google/callback

# Default model registry ID for all new native agents (explicit choices override it).
# NEST_DEFAULT_AGENT_MODEL_ID=nest-kimi-k3

# Personal agent onboarding: existing enabled engine model and registered runner.
# Legacy fallback when NEST_DEFAULT_AGENT_MODEL_ID is unset.
# NEST_PERSONAL_AGENT_MODEL_ID=
# NEST_PERSONAL_AGENT_RUNNER_ID=
# NEST_PERSONAL_AGENT_WORKSPACE_ROOT=/app/.nest-data/workspaces/personal
# Nest-only provider adapter; fixed HTTPS return path, no query string.
# NEST_COMPOSIO_API_KEY=
# NEST_COMPOSIO_INSTANCE_ID=nest-camplight
# NEST_COMPOSIO_CALLBACK_URL=https://nest.camplight.net/onboarding
# NEST_COMPOSIO_AUTH_CONFIGS={"trello":"ac_configured_by_operator"}

# Optional global engine token for Nest metadata checks (fallback: NEST_RUNNER_TOKEN).
# Must be the GLOBAL token; scoped credentials can hide channel subscriptions.
# NEST_CONNECTION_METADATA_TOKEN=
# Remote runners need the product API URL for the nest-connections skill:
# NEST_CONNECTIONS_URL=https://nest.camplight.net

# Permanent create-only permission for one trusted wrapped manager. Disabled unless both match.
# Get the existing agent ID through the authenticated engine API, then install
# deploy/nestsystem-bridge.mjs as described in docs/AGENT_MANAGEMENT.md.
# NEST_MANAGEMENT_AGENT_NAME=NestSystem
# NEST_MANAGEMENT_AGENT_ID=
# Optional product origin for a remote trusted bridge (HTTPS; default loopback:8789).
# NEST_MANAGEMENT_URL=https://nest.example.com

# Optional core project naming model; defaults to NEST_DEFAULT_AGENT_MODEL_ID.
# Choose an enabled OpenRouter model registry ID to reuse your OpenRouter account.
# The durable worker requires NEST_RUNNER_TOKEN for engine metadata reads;
# the key-source agent does not need to be online.
# Uses server-side provider env keys, or the configured system agent’s encrypted
# engine provider keys over HTTP (owner-human secret delegation must be disabled).
# NEST_PROJECT_NAMING_AGENT_NAME=NestSystem
# Naming failure preserves the first-message label and never blocks chat.
# NEST_PROJECT_NAMING_MODEL_ID=nest-kimi-k3
