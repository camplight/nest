# Optional local rehearsal; CI runs on a fresh Ubuntu VM without Docker.
FROM ubuntu:24.04
ENV container=docker
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd libpam-systemd dbus-user-session ca-certificates curl python3 git rsync && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
