[Unit]
Description=Nest runner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
After=nest-engine.service
Wants=nest-engine.service

[Service]
Type=simple
User=node
Group=node
WorkingDirectory=/app
Environment=NODE_ENV=production
Environment=HOME=/home/node
Environment=NEST_RUNNER_ID_FILE=/app/.nest-data/runner-id
Environment=CODEX_HOME=/app/.nest-data/codex-home
Environment=PATH=/opt/nest/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=8787
Environment=NEST_BIND_HOST=127.0.0.1
Environment=ORGOPS_PORT=8788
Environment=ORGOPS_BIND_HOST=127.0.0.1
Environment=ORGOPS_URL=http://127.0.0.1:8788
Environment=NEST_RUNNER_API_URL=http://127.0.0.1:8788
Environment=NEST_MANAGEMENT_URL=http://127.0.0.1:8787
ExecStart=/opt/nest/node/bin/node --env-file=/etc/nest/runtime.env --import tsx scripts/start-orgops.ts runner
Slice=nest.slice
MemoryMax=768M
CPUWeight=25
TasksMax=256
UMask=0077
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
