[Unit]
Description=Nest LiveKit voice media service
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/nest/livekit-enabled

[Service]
Type=simple
User=nest-livekit
Group=nest-livekit
ExecStart=/opt/nest/livekit/livekit-server --config /etc/nest/livekit.yaml
Environment=GOMEMLIMIT=192MiB
Environment=GOMAXPROCS=2
Slice=nest.slice
MemoryMax=256M
CPUWeight=100
TasksMax=128
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
