[Unit]
Description=Nest HTTPS and static UI server
After=network-online.target nest-api.service
Wants=network-online.target
[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/nest/host.env
Environment=XDG_DATA_HOME=/var/lib/nest-caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/nest-caddy/config
ExecStart=/opt/nest/caddy/caddy run --config /etc/nest/Caddyfile --adapter caddyfile
ExecReload=/opt/nest/caddy/caddy reload --config /etc/nest/Caddyfile --adapter caddyfile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nest-caddy
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=3
MemoryMax=128M
TasksMax=128
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
