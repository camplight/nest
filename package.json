{
  "name": "nest",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/orgops/apps/api",
    "vendor/orgops/apps/agent-runner",
    "vendor/orgops/packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- npm run --workspace @nest/api dev",
    "dev:runner:after-api": "node --env-file-if-exists=.env --import tsx scripts/start-orgops.ts runner",
    "dev:all": "dotenv -e .env -- concurrently -k \"npm run start:api:env\" \"npm run admin-ui:dev\" \"npm run user-ui:dev\" \"npm run dev:runner:after-api\"",
    "dev:all:no-api": "dotenv -e .env -- concurrently -k \"npm run admin-ui:dev\" \"npm run user-ui:dev\" \"npm run dev:runner:after-api\"",
    "dev:all:clean": "node --env-file=.env --import tsx scripts/dev-all-clean.ts",
    "build": "npm run --workspace @nest/admin-ui build && npm run --workspace @nest/user-ui build",
    "prod:runner:after-api": "npm run dev:runner:after-api",
    "prod:all": "npm run build && npm run start:all",
    "admin-ui:dev": "npm run --workspace @nest/admin-ui dev",
    "admin-ui:build": "npm run --workspace @nest/admin-ui build",
    "user-ui:dev": "npm run --workspace @nest/user-ui dev --",
    "user-ui:build": "npm run --workspace @nest/user-ui build",
    "start:api:env": "node --env-file-if-exists=.env --import tsx scripts/start-stack.ts api",
    "start:runner:env": "node --env-file-if-exists=.env --import tsx scripts/start-orgops.ts runner",
    "start:admin-ui:preview:env": "node --env-file=.env ./node_modules/vite/bin/vite.js preview apps/admin-ui --config apps/admin-ui/vite.config.ts --host 0.0.0.0 --port 4173",
    "start:user-ui:preview:env": "node --env-file=.env ./node_modules/vite/bin/vite.js preview apps/user-ui --config apps/user-ui/vite.config.ts --host 0.0.0.0 --port 4190",
    "test": "vitest run",
    "lint": "npm run lint:all && tsc -p tsconfig.scripts.json --noEmit",
    "lint:all": "npm run lint --workspaces --if-present",
    "scenario:test": "npm run --workspace @orgops/events-scenario-tests run",
    "scenario:test:countdown": "npm run --workspace @orgops/events-scenario-tests run:countdown",
    "dev:orgops": "node --env-file-if-exists=.env --import tsx scripts/start-orgops.ts api",
    "start:all": "node --env-file-if-exists=.env --import tsx scripts/start-stack.ts",
    "engine:install": "git submodule update --init --recursive vendor/orgops",
    "test:engine": "cd vendor/orgops && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.engine.config.ts",
    "migrate:product": "node --import tsx scripts/migrate-product-data.ts",
    "test:ui:agents": "node tests/browser/agents.mjs",
    "test:ui:projects": "node --import tsx tests/browser/projects.ts",
    "test:ui:community": "node --import tsx tests/browser/community.ts",
    "test:ui:auth": "node --import tsx tests/browser/google-auth.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^8.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "cursor-agent": "^1.0.3"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "sqlite3": "^6.0.1",
    "tar": "^7.5.22",
    "undici": "^6.24.0"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true
  },
  "type": "module"
}
